<Window x:Class="CodeSchool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Code School" Width="1320" Height="880" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#0F1416" Icon="app.ico">
    <Grid>
        <TextBlock x:Name="Loading" Text="Opening Code School…" Foreground="#9FB0B8" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI"/>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0F1416"/>
    </Grid>
</Window>
